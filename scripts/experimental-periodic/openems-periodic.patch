+CSProperties* Operator::PeriodicProperty(const double* coords, std::vector<CSPrimitives*> vPrims, bool markAsUsed) const
+{
+	double wrapped[3]={coords[0],coords[1],coords[2]};
+	for (int a=0; a<3; ++a) if (IsPeriodic(a))
+	{
+		double lo=discLines[a][0], length=discLines[a][numLines[a]-1]-lo;
+		wrapped[a]=lo+fmod(fmod(wrapped[a]-lo,length)+length,length);
+	}
+	coords=wrapped;
+	CSProperties* prop = NULL;
+	if (IsPeriodic(0) || IsPeriodic(1))
+	{
+		// Quarter-cell samples can lie exactly on a box face. Modulo arithmetic and
+		// translated coordinates may differ by a few ulps. Preserve the inclusive
+		// box convention within roundoff, not a mesh-sized geometric tolerance.
+		// This restricted backend rejects non-box and transformed materials.
+		for (size_t i=0; i<vPrims.size(); ++i)
+		{
+			double bounds[6];
+			if (!vPrims[i]->GetBoundBox(bounds)) continue;
+			bool inside=true;
+			for (int a=0; a<3; ++a)
+			{
+				double scale=std::max(fabs(coords[a]),std::max(fabs(bounds[2*a]),fabs(bounds[2*a+1])));
+				scale=std::max(scale,GetDiscDelta(a,0));
+				double tol=64*std::numeric_limits<double>::epsilon()*scale;
+				inside=inside && coords[a]>=bounds[2*a]-tol && coords[a]<=bounds[2*a+1]+tol;
+			}
+			if (inside)
+			{
+				prop=vPrims[i]->GetProperty();
+				if (markAsUsed) vPrims[i]->SetPrimitiveUsed(true);
+				break; // candidate list is priority sorted, as in CSXCAD
+			}
+		}
+	}
+	else prop = CSX->GetPropertyByCoordPriority(coords,vPrims,markAsUsed);
+
+	return prop;
+}
