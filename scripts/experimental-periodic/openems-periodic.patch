+
 bool openEMS::SetupBoundaryConditions()
 {
+	bool periodic=false;
+	for (int n=0; n<6; ++n) periodic=periodic || m_BC_type[n]==4;
+	if (periodic)
+	{
+		if (CylinderCoords || m_engine!=EngineType_Basic || m_CellConstantMaterial ||
+		    m_BC_type[0]!=4 || m_BC_type[1]!=4 || m_BC_type[2]!=4 || m_BC_type[3]!=4 ||
+		    m_BC_type[4]!=3 || m_BC_type[5]!=3)
+		{
+			cerr << "PERIODIC_TEST requires basic Cartesian CPU, quarter-cell averaging, paired x/y periodic and z PML." << endl;
+			return false;
+		}
+		for (int a=0; a<2; ++a)
+		{
+			unsigned int count=FDTD_Op->GetNumberOfLines(a);
+			double step=FDTD_Op->GetDiscDelta(a,0);
+			if (count<4 || step<=0) return false;
+			for (unsigned int i=1; i<count-1; ++i)
+				if (fabs(FDTD_Op->GetDiscDelta(a,i)-step)>1e-9*step)
+				{ cerr << "PERIODIC_TEST requires uniform transverse mesh." << endl; return false; }
+		}
+		for (size_t i=0; i<m_CSX->GetQtyProperties(); ++i)
+		{
+			CSProperties* p=m_CSX->GetProperty(i);
+			int type=p->GetType();
+			if (type!=CSProperties::MATERIAL && type!=CSProperties::METAL && type!=CSProperties::EXCITATION && type!=CSProperties::PROBEBOX)
+			{ cerr << "PERIODIC_TEST only permits nondispersive material, PEC, source and probe properties." << endl; return false; }
+		}
+		std::vector<CSPrimitives*> materials=m_CSX->GetAllPrimitives(true,(CSProperties::PropertyType)(CSProperties::MATERIAL | CSProperties::METAL));
+		for (size_t i=0; i<materials.size(); ++i)
+		{
+			double bounds[6];
+			if (!dynamic_cast<CSPrimBox*>(materials[i]) || materials[i]->HasTransform() || !materials[i]->GetBoundBox(bounds))
+			{ cerr << "PERIODIC_TEST only permits axis-aligned material boxes." << endl; return false; }
+		}
+		double invSquare=0;
+		for (int a=0; a<3; ++a)
+		{
+			double h=FDTD_Op->GetDiscDelta(a,0);
+			for (unsigned int j=1; j<FDTD_Op->GetNumberOfLines(a)-1; ++j)
+				h=(std::min)(h,FDTD_Op->GetDiscDelta(a,j));
+			h*=FDTD_Op->GetGridDelta(); invSquare+=1/(h*h);
+		}
+		if (!(m_TS>0 && m_TS<=0.95/(299792458.0*sqrt(invSquare))))
+		{ cerr << "PERIODIC_TEST requires an explicit timestep at or below 95% of vacuum CFL." << endl; return false; }
+		if (FDTD_Op->GetBackgroundEpsR()!=1 || FDTD_Op->GetBackgroundMueR()!=1 || FDTD_Op->GetBackgroundKappa()!=0 || FDTD_Op->GetBackgroundSigma()!=0)
+		{ cerr << "PERIODIC_TEST requires a vacuum background." << endl; return false; }
+		for (size_t i=0; i<m_CSX->GetQtyProperties(); ++i)
+		{
+			CSProperties* p=m_CSX->GetProperty(i);
+			if (p->GetType()==CSProperties::EXCITATION && dynamic_cast<CSPropExcitation*>(p)->GetExcitType()!=0)
+			{ cerr << "PERIODIC_TEST requires a soft electric source." << endl; return false; }
+			if (p->GetType()==CSProperties::MATERIAL)
+			{
+				CSPropMaterial* m=dynamic_cast<CSPropMaterial*>(p);
+				if (!m->GetIsotropy() || !(m->GetEpsilon()>=1 && m->GetMue()>=1 && m->GetKappa()>=0 && m->GetSigma()>=0))
+				{ cerr << "PERIODIC_TEST requires passive isotropic materials with eps_r, mu_r >= 1." << endl; return false; }
+				double weightPoint[3]={0,0,0};
+				for (int a=0; a<3; ++a)
+					if (m->GetEpsilonWeighted(a,weightPoint)!=m->GetEpsilon(a) || m->GetMueWeighted(a,weightPoint)!=m->GetMue(a) || m->GetKappaWeighted(a,weightPoint)!=m->GetKappa(a) || m->GetSigmaWeighted(a,weightPoint)!=m->GetSigma(a) || (!m->GetEpsilonWeightFunction(a).empty() && m->GetEpsilonWeightFunction(a)!="1") || (!m->GetMueWeightFunction(a).empty() && m->GetMueWeightFunction(a)!="1") || (!m->GetKappaWeightFunction(a).empty() && m->GetKappaWeightFunction(a)!="1") || (!m->GetSigmaWeightFunction(a).empty() && m->GetSigmaWeightFunction(a)!="1"))
+					{ cerr << "PERIODIC_TEST requires spatially constant material properties." << endl; return false; }
+			}
+		}
+		cout << "EXPERIMENTAL zero-phase periodic x/y, scalar CPU; not Floquet port support." << endl;
+	}
 	FDTD_Op->SetBoundaryCondition(m_BC_type); //operator only knows about PEC and PMC, everything else is defined by extensions (see below)
 
 	/**************************** create all operator/engine extensions here !!!! **********************************/
@@ -937,6 +1009,8 @@ bool openEMS::Parse_XML_FDTDSetup(TiXmlElement* FDTD_Opts)
