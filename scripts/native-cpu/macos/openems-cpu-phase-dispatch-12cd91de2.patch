+
+bool Engine_Multithread::PhaseDispatchMatchesExtensions() const
+{
+	if (m_phaseDispatchExtensions.size() != m_Eng_exts.size())
+		return false;
+	for (size_t n = 0; n < m_Eng_exts.size(); ++n)
+		if (m_phaseDispatchExtensions[n] != m_Eng_exts[n])
+			return false;
+	return true;
+}
