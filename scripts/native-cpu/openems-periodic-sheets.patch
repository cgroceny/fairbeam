@@ -0,0 +1,41 @@
+// Experimental closed-alpha conducting-sheet topology. GPL-3.0-or-later.
+#ifndef CONDUCTING_SHEET_PERIODIC_TOPOLOGY_H
+#define CONDUCTING_SHEET_PERIODIC_TOPOLOGY_H
+
+#include <cstring>
+
+namespace ConductingSheetPeriodicTopology
+{
+inline bool Enabled(const char* option, bool closedAlpha, unsigned int angularLines, bool originalExtension = true)
+{
+	return originalExtension && option && std::strcmp(option, "periodic") == 0 && closedAlpha && angularLines >= 4;
+}
+
+inline bool BoundaryBlocked(unsigned int direction, unsigned int position,
+	unsigned int lines, unsigned int lowerSize, unsigned int upperSize, bool periodic)
+{
+	// Both seam representatives are usable. The final angular ghost is not.
+	if (periodic && direction == 1)
+		return position >= lines - 1;
+	return position <= lowerSize || position >= lines - upperSize - 1;
+}
+
+inline unsigned int Previous(unsigned int direction, unsigned int position,
+	unsigned int angularLines, bool periodic)
+{
+	// numLines includes the duplicated seam and the final angular ghost.
+	if (periodic && direction == 1 && position == 0)
+		return angularLines - 3;
+	return position - 1;
+}
+
+inline unsigned int PrimitiveAlpha(unsigned int position, unsigned int angularLines, bool periodic)
+{
+	// Query the same physical primitives as GetYeeCoords at aliased planes.
+	if (periodic && position >= angularLines - 2)
+		return position - (angularLines - 2);
+	return position;
+}
+}
+
+#endif
