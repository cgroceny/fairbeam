@@ -340,6 +354,45 @@ void Operator_Ext_UPML::CalcGradingKappa(int ny, unsigned int pos[3], double Zm,
 			kappa_i[n] = 0;
 		}
 	}
+	// With s_r = 1 + sigma_r/(s*eps0), cylindrical stretching also gives
+	// s_phi = r_tilde/r = 1 + integral(sigma_r dr)/(s*eps0*r).
+	// The existing UPML tensor update can represent this azimuthal stretch.
+	if (m_Op_Cyl && m_BC[1]==3 && g_settings.hasOption("pml-cylindrical-metric"))
+	{
+		const unsigned int last = m_Op->GetNumberOfLines(0,true)-1;
+		const double unit = m_Op->GetGridDelta();
+		const double r_start = m_Op->GetDiscLine(0,last-m_Size[1])*unit;
+		const double width = (m_Op->GetDiscLine(0,last)*unit-r_start);
+		const double r_node = m_Op->GetDiscLine(0,pos[0])*unit;
+		const double half_edge = m_Op->GetEdgeLength(0,pos)/2;
+		// Eight-point Gauss-Legendre integration is performed only at setup.
+		const double nodes[4] = {0.1834346424956498,0.5255324099163290,
+			0.7966664774136267,0.9602898564975363};
+		const double weights[4] = {0.3626837833783620,0.3137066458778873,
+			0.2223810344533745,0.1012285362903763};
+		auto curvature_sigma = [&](double radius)
+		{
+			const double depth = std::min(width, std::max(0.0,radius-r_start));
+			if (depth<=0 || radius<=0) return 0.0;
+			double integral = 0;
+			// Eight panels retain accuracy for all supported reference counts 1..64.
+			const int panels = 8;
+			for (int panel=0; panel<panels; ++panel)
+				for (int q=0; q<4; ++q)
+					for (int sign=-1; sign<=1; sign+=2)
+					{
+						double vars[5] = {depth/panels*(panel+(1+sign*nodes[q])/2),
+							width/m_Size[1],width,Zm,(double)m_Size[1]};
+						const double sigma = m_GradingFunction->Eval(vars);
+						if (m_GradingFunction->EvalError() || !std::isfinite(sigma) || sigma<0)
+							throw std::invalid_argument("cylindrical PML needs a finite nonnegative grading profile");
+						integral += weights[q]*sigma;
+					}
+			return integral*depth/(2*panels*radius);
+		};
+		kappa_v[1] = curvature_sigma(r_node + (ny==0 ? half_edge : 0));
+		kappa_i[1] = curvature_sigma(r_node + (ny!=0 ? half_edge : 0));
+	}
 }
 
