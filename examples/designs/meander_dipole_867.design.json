{
  "schema": "fairbeam.design/1",
  "model": {
    "id": "meander-dipole-867",
    "name": "Printed meander dipole (867 MHz)",
    "description": "Vertical printed dipole for a UAV with a non-metal (composite or foam) fuselage: it needs no ground plane. Each arm is a straight strip from the centre feed that ends in a meandered tip, printed as copper on one face of a 1.6 mm FR-4 board with a blade-like outline (x: flight axis, +x aft; z: up). A balanced 50 ohm lumped port bridges the centre gap; a real build needs a balun or a common-mode choke, and the coax is not modelled. Tuned about 1.3 % above 867 MHz for the 863-870 MHz SRD / LoRa band, as a margin for a radome. See examples/designs/README.md in the fairbeam repository."
  },
  "params": [
    {"key": "f0", "default": 0.867, "label": "Design frequency", "unit": "GHz", "min": 0.1, "max": 6},
    {"key": "w", "default": 2, "label": "Trace width", "unit": "mm", "min": 0.5, "max": 6},
    {"key": "g", "default": 2, "label": "Feed gap (port length)", "unit": "mm", "min": 0.5, "max": 10},
    {"key": "l_feed", "default": 30, "label": "Straight section from the gap to the meander", "unit": "mm", "min": 2, "max": 80},
    {"key": "n", "default": 2, "label": "Meander turns per arm", "unit": "", "min": 1, "max": 10},
    {"key": "a", "default": 16, "label": "Meander turn width (x)", "unit": "mm", "min": 4, "max": 60},
    {"key": "p", "default": 8, "label": "Meander turn pitch (z, two rungs)", "unit": "mm", "min": 2, "max": 30},
    {"key": "l_end", "default": 1.5, "label": "Straight end section at the tip", "unit": "mm", "min": 0, "max": 40},
    {"key": "t", "default": 1.6, "label": "FR-4 thickness", "unit": "mm", "min": 0.2, "max": 3.2},
    {"key": "t_cu", "default": 0.035, "label": "Copper thickness (built as a sheet)", "unit": "mm", "min": 0.009, "max": 0.105},
    {"key": "m", "default": 3, "label": "Board margin around the copper", "unit": "mm", "min": 0.5, "max": 20},
    {"key": "sweep", "default": 12, "label": "Extra board chord forward at the root (blade sweep)", "unit": "mm", "min": 0, "max": 60},
    {"key": "lam", "expr": "wavelength(f0)", "label": "Free-space wavelength at f0", "unit": "mm"},
    {"key": "nt", "expr": "max(1, round(n))", "label": "Meander turns per arm, a whole number", "unit": ""},
    {"key": "z1", "expr": "g / 2 + l_feed", "label": "Bottom of the first meander rung (upper arm)", "unit": "mm"},
    {"key": "z_tip", "expr": "z1 + nt * p + w + l_end", "label": "Tip of the upper arm", "unit": "mm"},
    {"key": "H", "expr": "2 * z_tip", "label": "Copper height, tip to tip", "unit": "mm"},
    {"key": "L_arm", "expr": "l_feed + 2 * nt * a + nt * p + w + l_end", "label": "Trace length of one arm (approx.)", "unit": "mm"},
    {"key": "H_board", "expr": "H + 2 * m", "label": "Board height", "unit": "mm"},
    {"key": "W_board", "expr": "a + 2 * m + sweep", "label": "Board chord at the root", "unit": "mm"}
  ],
  "simulation": {
    "f_min": "0.75",
    "f_max": "1.0",
    "boundaries": "PML_8",
    "end_criteria_db": -50
  },
  "materials": [
    {"name": "copper", "kind": "metal"},
    {"name": "FR4", "kind": "dielectric", "eps_r": 4.3, "tan_d": 0.02, "tan_d_freq": "f0"}
  ],
  "parts": [
    {
      "name": "board",
      "material": "FR4",
      "component": "antenna",
      "primitives": [
        {"kind": "linpoly", "normal": "y", "elevation": 0, "length": "t", "points": [
          ["-z_tip - m", "-a/2 - m - sweep"], ["-z_tip - m", "a/2 + m"], [0, "a/2 + m"], [0, "-a/2 - m - sweep/2"]
        ]},
        {"kind": "linpoly", "normal": "y", "elevation": 0, "length": "t", "points": [
          [0, "-a/2 - m - sweep/2"], [0, "a/2 + m"], ["z_tip + m", "a/2 + m"], ["z_tip + m", "-a/2 - m"]
        ]}
      ]
    },
    {
      "name": "arm_feed_and_tip",
      "material": "copper",
      "component": "antenna/arms",
      "primitives": [
        {"kind": "box", "start": ["-w/2", "-t_cu", "g/2"], "stop": ["w/2", 0, "z1"]},
        {"kind": "box", "start": ["-w/2", "-t_cu", "z1"], "stop": ["a/2", 0, "z1 + w"]},
        {"kind": "box", "start": ["-a/2", "-t_cu", "z1 + nt * p"], "stop": ["w/2", 0, "z1 + nt * p + w"]},
        {"kind": "box", "start": ["-w/2", "-t_cu", "z1 + nt * p"], "stop": ["w/2", 0, "z_tip"]}
      ],
      "transforms": [{"type": "mirror", "plane": "z", "keep": true}]
    },
    {
      "name": "arm_rungs",
      "material": "copper",
      "component": "antenna/arms",
      "primitives": [
        {"kind": "box", "start": ["-a/2", "-t_cu", "z1 + p/2"], "stop": ["a/2", 0, "z1 + p/2 + w"]}
      ],
      "transforms": [
        {"type": "translate", "copies": "2 * nt - 2", "step": [0, 0, "p/2"]},
        {"type": "mirror", "plane": "z", "keep": true}
      ]
    },
    {
      "name": "arm_links_aft",
      "material": "copper",
      "component": "antenna/arms",
      "primitives": [
        {"kind": "box", "start": ["a/2 - w", "-t_cu", "z1 + w"], "stop": ["a/2", 0, "z1 + p/2"]}
      ],
      "transforms": [
        {"type": "translate", "copies": "nt - 1", "step": [0, 0, "p"]},
        {"type": "mirror", "plane": "z", "keep": true}
      ]
    },
    {
      "name": "arm_links_fwd",
      "material": "copper",
      "component": "antenna/arms",
      "primitives": [
        {"kind": "box", "start": ["-a/2", "-t_cu", "z1 + p/2 + w"], "stop": ["-a/2 + w", 0, "z1 + p"]}
      ],
      "transforms": [
        {"type": "translate", "copies": "nt - 1", "step": [0, 0, "p"]},
        {"type": "mirror", "plane": "z", "keep": true}
      ]
    }
  ],
  "ports": [
    {"type": "lumped", "number": 1, "R": 50, "start": ["-w/2", 0, "-g/2"], "stop": ["w/2", 0, "g/2"], "direction": "z"}
  ],
  "resistors": [],
  "mesh": {"mode": "auto", "cells_per_wavelength": 20},
  "far_field": {"enabled": true, "frequencies": ["f0"]},
  "monitors": {"currents": ["f0"], "efficiency": {"points": 21}}
}
