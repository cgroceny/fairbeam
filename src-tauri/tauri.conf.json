{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairbeam",
  "version": "0.8.5",
  "identifier": "org.fairbeam.desktop",
  "build": {
    "frontendDist": "splash",
    "beforeDevCommand": "npm run desktop:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "publisher": "Fairbeam",
    "copyright": "Copyright © 2026 Fairbeam contributors",
    "shortDescription": "The open electromagnetic workbench.",
    "fileAssociations": [
      {
        "ext": ["fb"],
        "name": "Fairbeam document",
        "description": "Fairbeam document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.fairbeam.document+json",
        "exportedType": {
          "identifier": "org.fairbeam.document",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "ui/",
      "../python/fairbeam/*.py": "python/fairbeam/",
      "../python/fairbeam_elmer.py": "python/fairbeam_elmer.py",
      "../python/models/*.py": "models/",
      "../examples/designs/*_867.design.json": "models/",
      "../python/templates/*.py": "templates/",
      "../public/projects/": "projects/",
      "../runtime/pins.json": "runtime/pins.json",
      "../runtime/requirements.txt": "runtime/requirements.txt",
      "../runtime/install.py": "runtime/install.py",
      "../runtime/setup-runtime.sh": "runtime/setup-runtime.sh",
      "../runtime/setup-runtime.ps1": "runtime/setup-runtime.ps1",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE.md": "NOTICE.md",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCODZFNDBFNjZDMkJEMzkKUldRNXZjSm1EdVNHTzA3aE1MdWhycWs0M2tUa3YxTldtK0hIaFF5Q2h4MFk0MmZrdEc5OE5jTXIK",
      "endpoints": [
        "https://github.com/ismailakdag/fairbeam-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
