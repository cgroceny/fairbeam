    "sim.started.gpu.python",
    "sim.finished.cpu.design",
    "sim.finished.cpu.example",
    "sim.finished.cpu.python",
    "sim.finished.gpu.design",
    "sim.finished.gpu.example",
    "sim.finished.gpu.python",
    "sim.failed.cpu.start",
    "sim.failed.cpu.server",
    "sim.failed.cpu.no-result",
    "sim.failed.cpu.solver",
    "sim.failed.cpu.memory",
    "sim.failed.cpu.gpu",
    "sim.failed.cpu.timeout",
    "sim.failed.cpu.mesh-cells",
    "sim.failed.cpu.design",
    "sim.failed.cpu.crash",
    "sim.failed.cpu.interrupted",
    "sim.failed.cpu.other",
    "sim.failed.gpu.start",
    "sim.failed.gpu.server",
    "sim.failed.gpu.no-result",
    "sim.failed.gpu.solver",
    "sim.failed.gpu.memory",
    "sim.failed.gpu.gpu",
    "sim.failed.gpu.timeout",
    "sim.failed.gpu.mesh-cells",
    "sim.failed.gpu.design",
    "sim.failed.gpu.crash",
    "sim.failed.gpu.interrupted",
    "sim.failed.gpu.other",
    "sim.cancelled.cpu",
    "sim.cancelled.gpu",
